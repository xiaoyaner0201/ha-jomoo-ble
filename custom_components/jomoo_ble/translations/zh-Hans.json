      "user": {
        "title": "九牧 ZS800J（蓝牙）",
        "description": "请先关闭官方小程序：马桶同一时间只接受一个蓝牙连接。添加时会做一次只读状态查询（马桶会嘀一声）。控制功能默认关闭。",
        "data": {
          "address": "蓝牙 MAC 地址",
          "name_prefix": "广播名称前缀"
        }
      },
      "bluetooth_confirm": {
        "title": "九牧 ZS800J（蓝牙）",
        "description": "要添加 {name} 吗？请先关闭官方小程序。添加时会做一次只读状态查询（马桶会嘀一声）。"
      }
    },
    "error": {
      "invalid_address": "请输入用冒号分隔的六组两位十六进制数。",
