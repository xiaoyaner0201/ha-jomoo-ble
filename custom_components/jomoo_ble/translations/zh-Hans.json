  "options": {
    "step": {
      "init": {
        "title": "控制与刷新",
        "description": "每次蓝牙连接会嘀一声，且只允许一个 central。启用实时状态后会持续占用连接，官方小程序需等关闭选项或卸载释放后才能连接。首次连接会响；实时模式忽略轮询，断线后仅手动点击刷新状态重试。",
        "data": {
          "enable_status_stream": "启用持续实时状态（单 central 占用；连接会响）",
          "enable_controls": "启用已验证的控制（翻盖、翻圈、小冲、自动翻盖、脚感）",
          "enable_experimental": "启用实验性控制（温度、水压、喷嘴、风速、宽幅洗、自动冲水、自动夜灯、UV、关盖冲水、自动小冲、氛围灯、大冲）",
          "poll_interval": "自动刷新间隔（秒，0 为关闭，其他取 300–86400）"
        }
      }
    },
    "error": {
      "invalid_interval": "请填 0，或 300 到 86400 之间的数。"
    }
