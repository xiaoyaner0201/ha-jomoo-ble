{
  "title": "JOMOO BLE",
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "JOMOO ZS800J (Bluetooth)",
        "description": "Close the official mini program first: the toilet accepts only one Bluetooth connection. Setup performs one read-only status query (the toilet will beep once). Controls start disabled.",
        "data": {
          "address": "Bluetooth MAC address",
          "name_prefix": "Advertised name prefix"
        }
      },
      "bluetooth_confirm": {
        "title": "JOMOO ZS800J (Bluetooth)",
        "description": "Set up {name}? Close the official mini program first. Setup performs one read-only status query (the toilet will beep once)."
      }
    },
    "error": {
      "invalid_address": "Enter six two-digit hexadecimal groups separated by colons.",
      "invalid_prefix": "A name prefix is required.",
      "cannot_connect": "No fresh status received. Check the Bluetooth proxy placement and that no other app is connected."
    },
    "abort": {
      "already_configured": "This toilet is already configured.",
      "not_supported": "This model is not supported."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Controls and refresh",
        "description": "Every connection makes the toilet beep and blocks the official app for a few seconds, so automatic polling is off by default (0).",
